# Existing AI-Socratus settings: keep your current key and model on the server.
GEMINI_API_KEY=
GEMINI_MODEL=
CHAT_ENABLED=true
RATE_LIMIT_PER_IP=6
RATE_LIMIT_GLOBAL=20
MAX_CONCURRENT_REQUESTS=2

# Token of @youni4st_bot from BotFather. Never put it in Flutter or GitHub.
TELEGRAM_BOT_TOKEN=
# Production: PostgreSQL connection string, or SQLITE_PATH on a persistent disk.
DATABASE_URL=
# Local development default only: data/miniapp.sqlite3
# SQLITE_PATH=/var/data/miniapp.sqlite3
# Exact frontend origin(s), no trailing slash. Same-origin hosting needs no CORS.
ALLOWED_ORIGINS=http://localhost:8080

# Optional legacy CRM consultations/applications. Server-side only.
BITRIX_WEBHOOK_URL=
